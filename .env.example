# Base URL (ap-southeast-1 region — donde está tu console de BytePlus)
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Default model ID
# - dreamina-seedance-2-0-260128       → Standard / Pro (con audio)
# - dreamina-seedance-2-0-fast-260128  → Fast (sin audio)
DEFAULT_MODEL=dreamina-seedance-2-0-fast-260128

# Local server port
PORT=3300

# NOTE: Las API keys ahora se gestionan desde la UI (panel superior derecho).
# Se guardan en ./keys.json (no se sube a git, está en .gitignore).
# Puedes agregar/cambiar/eliminar keys sin reiniciar el server.
